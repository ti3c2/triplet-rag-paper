## Minimal setup

## Dataset to use: "natural-questions", "squad"
# RAG_DATASET=natural-questions

## OpenAI
# OPENAI_API_KEY=
# OPENAI_API_base=https://api.openai.com/v1/
# OPENAI_MODEL=gpt-4o-mini
# QUESTION_GENERATION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_PROXY_URL=
# OPENAI_USE_PROXY=True


## vLLM
# OPENAI_API_BASE=http://localhost:3000/v1/
# OPENAI_API_BASE_EMBEDDING=http://localhost:3001/v1/
# OPENAI_MODEL=google/gemma-2-9b-it
# QUESTION_GENERATION_MODEL=google/gemma-2-9b-it
# OPENAI_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# LOG_LEVEL=10

## Extended Setup by Sonnet

# =============================================================================
# OpenAI Configuration
# =============================================================================

OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_BASE_EMBEDDING=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Proxy settings (optional)
OPENAI_PROXY_URL=http://user:pwd@ip_address:port
OPENAI_USE_PROXY=false


# # For VLLM
OPENAI_USE_VLLM=true
OPENAI_API_BASE=http://localhost:3000/v1/
OPENAI_API_BASE_EMBEDDING=http://localhost:3001/v1/
# OPENAI_MODEL=unsloth/Meta-Llama-3.1-8B-Instruct
OPENAI_MODEL=google/gemma-2-9b-it
QUESTION_GENERATION_MODEL=${OPENAI_MODEL}
RAG_GENERATION_MODEL=${OPENAI_MODEL}
OPENAI_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# Proxy settings (optional)
OPENAI_PROXY_URL=http://user:pwd@ip-address:port
OPENAI_USE_PROXY=false

# Batching Settings
OPENAI_CHAT_COMPLETION_BATCH_SIZE=10
OPENAI_EMBEDDING_BATCH_SIZE=200
OPENAI_RAG_BATCH_SIZE=100

# Retries Settings
OPENAI_MAX_RETRIES=5
OPENAI_TIMEOUT=0.5

# =============================================================================
# RAG Settings
# =============================================================================

# Dataset to use: "natural-questions", "squad", or "multihoprag"
RAG_DATASET=squad

# Retrieval sources (JSON array): ["chunk", "query"] or ["chunk"] or ["query"]
RAG_RETRIEVAL_SOURCES=["chunk", "query"]

# Retrieval configuration
RAG_MAX_ROWS=10000
RAG_RETRIEVAL_MODE=knn
RAG_RETRIEVAL_METRIC=cosine
RAG_RETRIEVAL_ALGORITHM=brute
# RAG_RETRIEVAL_KS=[1, 5, 20]
RAG_DEDUPLICATION_FACTOR=5

# Generation settings
RAG_GENERATE_ANSWER=false
RAG_GENERATION_TEMPERATURE=0.1
RAG_GENERATION_MAX_TOKENS=1000

# Eval write settings
RAG_WRITE_JSON=true
RAG_WRITE_TXT=true

# =============================================================================
# RAGAS Settings
# =============================================================================

RAGAS_ENABLED=1
EVAL_LLM=Qwen/Qwen2.5-32B-Instruct
EVAL_LLM_API_BASE=http://localhost:7115/v1/
EVAL_EMBEDDING_MODEL=jinaai/jina-embeddings-v3
EVAL_EMBEDDING_MODEL_API_BASE=http://localhost:7117/v1/
# RAGAS_METRICS=[faithfulness,answer_relevancy,context_precision] # Don't set if you want all metrics
RAGAS_MAX_WORKERS=100
RAGAS_MAX_RETRIES=8
RAGAS_TIMEOUT=600
# RAGAS_BATCH_SIZE=10      # Batch size for RAGAS evaluation. Don't set unless you really want it
EVAL_CONTEXT_KS=[1,5,20]

# =============================================================================
# Prompt & Question Generation Settings
# =============================================================================

# Prompt mode: "basic" or "complex"
PROMPT_MODE=basic

# Prompt name from the src/config/prompts.py if you are using a custom prompt
# Leave empty for quote prompts
QUESTION_GENERATION_PROMPT_NAME=

# Question generation mode: "q", "qa", "qc"
QUESTION_GENERATION_MODE=qc

# Temperature for question generation
QUESTION_GENERATION_TEMPERATURE=0.7

# =============================================================================
# Logging Configuration
# =============================================================================

# Logging level (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR, 50=CRITICAL)
LOG_LEVEL=20

# PostgreSQL Configuration (Only if you are using PostgreSQL)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=9700
POSTGRES_DB=ragdb
